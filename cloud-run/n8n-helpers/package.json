{
    "name": "n8n-helpers",
    "version": "1.1.1",
    "description": "N8N Helpers service for Cloud Run",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "build": "tsx esbuild.config.ts",
        "start": "node dist/index.js",
        "dev": "tsx watch --clear-screen=false src/index.ts",
        "test": "vitest run",
        "type-check": "tsc --noEmit",
        "docker:run": "docker run -p 8080:8080 --env-file .env northbytestudio/n8n-helpers:latest",
        "deploy": "../../deploy-cloud-run.sh n8n-helpers"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.716.0",
        "@google-cloud/storage": "^7.18.0",
        "@types/cors": "^2.8.19",
        "@types/multer": "^2.0.0",
        "axios": "^1.7.9",
        "canvas": "^3.2.1",
        "convex": "^1.39.1",
        "cors": "^2.8.6",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "fluent-ffmpeg": "^2.1.3",
        "google-auth-library": "^10.5.0",
        "multer": "^2.0.2",
        "openai": "^6.45.0",
        "pino": "^10.2.1",
        "remove": "^0.1.5"
    },
    "devDependencies": {
        "@esbuild-plugins/tsconfig-paths": "^0.1.2",
        "@types/express": "^5.0.0",
        "@types/fluent-ffmpeg": "^2.1.27",
        "@types/node": "^25.0.9",
        "esbuild": "^0.27.2",
        "esbuild-node-externals": "^1.20.1",
        "nodemon": "^3.1.9",
        "tsconfig": "workspace:*",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "cloudRunConfig": {
        "image": "docker.io/northbytestudio/n8n-helpers:latest",
        "region": "europe-west3",
        "memory": "2Gi",
        "cpu": "2",
        "timeout": "3600",
        "max-instances": "50",
        "min-instances": "0",
        "concurrency": "1",
        "allow-unauthenticated": true
    }
}