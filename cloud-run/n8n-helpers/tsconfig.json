{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "tsconfig/cloud-functions.json",
    "compilerOptions": {
        "outDir": "./dist",
        "baseUrl": "./",
        "esModuleInterop": true,
        "paths": {
            "database/*": [
                "../../packages/database/src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}