# Email Configuration for Contact Form
# Gmail SMTP credentials
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
EMAIL_TO=your_email_to

# Note: For production, use environment variables instead of hardcoding credentials
# You can update the API route to use these environment variables:
# process.env.EMAIL_USER
# process.env.EMAIL_PASS
# process.env.EMAIL_TO

# Cloudflare R2 Configuration
# Get credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-bucket.r2.dev
N8N_API_KEY=YOUR_SUPER_SECRET_KEY_HERE

# Nanobana (AI Image Generation)
NANOBANA_API_URL=https://your-nanobana-endpoint.example.com/v1/generate
NANOBANA_API_KEY=your_nanobana_api_key

# Kling (Motion Control)
KLING_JWT_PASSWORD=your_kling_jwt_password

# Internal API Secret (used for /api/db/* generic endpoints)
INTERNAL_API_SECRET=your_internal_api_secret
